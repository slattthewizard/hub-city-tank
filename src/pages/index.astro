<script type="application/ld+json">{"@type": ["Plumber", "LocalBusiness"], "@id": "https://hubcitytank.ca/#organization", "name": "Hub City Tank Co", "url": "https://hubcitytank.ca", "logo": {"@type": "ImageObject", "url": "https://hubcitytank.ca/images/og-image.webp"}, "priceRange": "$$", "telephone": "(506) 802-3471", "email": "info@hubcitytank.ca", "address": {"@type": "PostalAddress", "addressLocality": "Moncton", "addressRegion": "NB", "addressCountry": "CA"}, "geo": {"@type": "GeoCoordinates", "latitude": 46.0878, "longitude": -64.7782}, "areaServed": [{"@type": "City", "name": "Moncton", "addressRegion": "NB"}, {"@type": "City", "name": "Dieppe", "addressRegion": "NB"}, {"@type": "City", "name": "Riverview", "addressRegion": "NB"}, {"@type": "City", "name": "Shediac", "addressRegion": "NB"}, {"@type": "City", "name": "Salisbury", "addressRegion": "NB"}, {"@type": "City", "name": "Memramcook", "addressRegion": "NB"}, {"@type": "City", "name": "Sackville", "addressRegion": "NB"}], "@context": "https://schema.org", "description": "Oil tank replacement and removal in Moncton, Dieppe and Riverview. Free written estimates, licensed and insured, 24/7 emergency line. Call (506) 802-3471.", "image": "https://hubcitytank.ca/images/og-image.webp", "hasOfferCatalog": {"@type": "OfferCatalog", "name": "Oil Tank Services", "itemListElement": [{"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Oil Tank Replacement"}}, {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Oil Tank Removal"}}, {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Buried Oil Tank Removal"}}, {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Emergency Oil Tank Service"}}]}}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "WebSite", "@id": "https://hubcitytank.ca/#website", "url": "https://hubcitytank.ca", "name": "Hub City Tank Co", "publisher": {"@id": "https://hubcitytank.ca/#organization"}}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "How much does oil tank replacement cost in Moncton?", "acceptedAnswer": {"@type": "Answer", "text": "Most standard residential replacements run $2,800 to $4,500, including the new tank, installation, transfer of your remaining oil, and disposal of the old tank. The final number depends on tank size, location, and whether your oil line or stand needs work. Every job starts with a free written estimate, so you'll know the price before we begin."}}, {"@type": "Question", "name": "How long does an oil tank replacement take?", "acceptedAnswer": {"@type": "Answer", "text": "Most swaps are done in a single day, often within a few hours. We drain and transfer your oil, set the new tank, hook everything up, and haul the old one away. You'll have heat again the same day."}}, {"@type": "Question", "name": "Do you charge more for after-hours emergency calls?", "acceptedAnswer": {"@type": "Answer", "text": "Yes, and we're upfront about it. Evening, weekend, and holiday emergency call-outs typically add $150 to $300 on top of regular rates, depending on the time and where you are. We'll quote the fee on the phone before we roll a truck, so there are no surprises on the invoice."}}, {"@type": "Question", "name": "Will my insurance company accept the new tank?", "acceptedAnswer": {"@type": "Answer", "text": "That's usually why people call us in the first place. We install tanks that meet the CSA B139 code and current New Brunswick requirements, and we give you the paperwork your insurer wants. If you got a letter with a deadline, tell us the date and we'll work to beat it."}}, {"@type": "Question", "name": "My oil tank is leaking right now. What should I do?", "acceptedAnswer": {"@type": "Answer", "text": "Stop the flow if you can do it safely, keep people and pets away from the oil, and call our 24/7 line at (506) 802-3471. Oil spills in New Brunswick need to be reported, and a fast response keeps the cleanup smaller. We'll talk you through the first steps on the phone and get help moving."}}, {"@type": "Question", "name": "Does my tank need to be replaced, or can it be repaired?", "acceptedAnswer": {"@type": "Answer", "text": "Age and condition tell most of the story. Steel tanks generally last 15 to 25 years, and once rust, weeping seams, or a sagging stand show up, replacement is almost always the safer money. We'll take a look, give you an honest read, and put the options in writing for free."}}]}</script>

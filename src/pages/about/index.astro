<script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Are you licensed and insured?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Hub City Tank Co is licensed and insured for residential oil tank work, and we're happy to show proof before the job starts. Your insurer can get a copy of the paperwork for their file too."}}, {"@type": "Question", "name": "How much does an estimate cost?", "acceptedAnswer": {"@type": "Answer", "text": "Nothing. Estimates are free, written, and good for the price we quote. We come out, look at your setup, and hand you the full number with no obligation to book."}}, {"@type": "Question", "name": "What should I do if my tank is leaking right now?", "acceptedAnswer": {"@type": "Answer", "text": "Call our 24/7 emergency line at (506) 802-3471. Shut off the tank valve if you can reach it safely, keep kids and pets away from the area, and don't try to move the tank yourself. We'll walk you through the next steps on the phone."}}]}</script>
